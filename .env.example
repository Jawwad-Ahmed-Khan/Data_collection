# =============================================================
# CLIMASYNC COLLECTION SERVICE — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values
# Never commit .env to git
# =============================================================

# ── DATABASE ─────────────────────────────────────────────────
# Collection Database (Supabase Project 2)
COLLECTION_DB_HOST=your-supabase-host.pooler.supabase.com
COLLECTION_DB_PORT=5432
COLLECTION_DB_NAME=postgres
COLLECTION_DB_USER=postgres.your-project-ref
COLLECTION_DB_PASSWORD=your-database-password-here
COLLECTION_DB_POOL_MIN=2
COLLECTION_DB_POOL_MAX=10


# ── MAIN SYSTEM CONNECTION ────────────────────────────────────
# Where we send breach alerts (main ClimaSync FastAPI)
MAIN_SYSTEM_BASE_URL=http://localhost:8001
MAIN_SYSTEM_API_KEY=generate-a-random-key-here

# ── EXTERNAL APIS ─────────────────────────────────────────────
# USGS Earthquake API (no key required)
USGS_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query

# Open-Meteo (no key required for free tier)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Google Flood Hub (requires Google Cloud API key)
GOOGLE_FLOOD_HUB_BASE_URL=https://floodhub.googleapis.com/v1
GOOGLE_FLOOD_HUB_API_KEY=your-google-cloud-api-key-here

# ── PAKISTAN GEOGRAPHIC BOUNDS ────────────────────────────────
# Do not change these values
PAKISTAN_MIN_LAT=23.0
PAKISTAN_MAX_LAT=38.0
PAKISTAN_MIN_LON=60.0
PAKISTAN_MAX_LON=78.0

# ── COLLECTION INTERVALS ──────────────────────────────────────
USGS_POLL_INTERVAL_SECONDS=300
OPENMETEO_POLL_INTERVAL_MINUTES=120
OPENMETEO_REQUEST_DELAY_MS=500
FLOOD_CURRENT_INTERVAL_MINUTES=60
FLOOD_FORECAST_INTERVAL_HOURS=6
BREACH_DISPATCH_INTERVAL_SECONDS=30
THRESHOLD_RELOAD_INTERVAL_HOURS=1
CLEANUP_HOUR_PKT=0
CLEANUP_MINUTE_PKT=5

# ── COLLECTION SETTINGS ───────────────────────────────────────
USGS_MIN_MAGNITUDE=2.5
USGS_LOOKBACK_HOURS=6
MAX_DISPATCH_ATTEMPTS=5
DISPATCH_BATCH_SIZE=10

# ── APPLICATION ───────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=climasync-collection
